# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Client-safe (public) config — safe to ship to the browser ---
# Unprefixed vars below are read by Phase 1's backend Vitest suite (tests/,
# via Node/dotenv). The VITE_-prefixed pair is what the frontend (src/, this
# phase) reads — Vite only exposes import.meta.env.VITE_* to client bundles,
# so both names are needed for the same two values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-only secrets — NEVER reference from client-side/browser code ---
# Used only by trusted server contexts (e.g. CI test setup, admin scripts,
# Edge Functions that explicitly need to bypass RLS). Phase 1's Postgres
# functions do NOT require this key: SECURITY DEFINER functions bypass RLS at
# the Postgres level, independent of this Supabase API key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (§6). Not configured in Phase 1 — no OAuth client exists yet
# for this project. Fill in and enable the Google provider in Supabase Auth
# settings once credentials are issued.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Dev-only test/fixture accounts (see supabase/README.md "Test accounts") ---
# Created directly in the dev Supabase project for Phase 1 verification. Never
# real credentials — rotate or delete before any production-adjacent use.
TEST_ADMIN_EMAIL=admin.superadmin@dev.madli.test
TEST_USER_EMAIL=user.test@dev.madli.test
TEST_OWNER_EMAIL=owner.test@dev.madli.test
TEST_ACCOUNT_PASSWORD=change-me

# Phase 3: a second admin account (different tier, partial grant — see
# PHASE_4_HANDOFF.md) so admin permission-scoped UI can be tested for real
# against an account that does NOT have every grant.
TEST_ADMIN2_EMAIL=admin.moderation@dev.madli.test

# Phase 3: the app's own deployed origin. Used by the share-preview Edge
# Function (supabase/functions/share-preview) to build canonical/OG URLs —
# set this as the Edge Function's APP_URL secret once a real deploy exists;
# falls back to a placeholder otherwise (see PHASE_4_HANDOFF.md).
# APP_URL=https://your-deployed-frontend.example

# --- Google Maps (§ discovery loop) ---
# Browser key for the Maps JavaScript API. Vite exposes VITE_-prefixed vars to
# the client bundle, which is correct here: a Maps browser key is public by
# design. The real control is an HTTP-referrer restriction on the key in
# Google Cloud Console, plus per-API quotas — not secrecy. Never paste a real
# key into this file; it is committed.
#
# Enable these on the Google Cloud project the key belongs to, or the app
# shows an "API not enabled" state instead of results:
#   - Maps JavaScript API  (map rendering)
#   - Places API (New)     (nearby/text search, place details, autocomplete)
#   - Routes API           (travel time and route polyline)
#   - Geocoding API        (only as a fallback when Places cannot resolve an area)
#
# If this is empty the app still runs: map and Google-backed search surfaces
# show a clear "not configured" state rather than crashing.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side Google calls (Edge Functions) must use their own secret rather
# than a second copy of the browser key in the bundle:
#   supabase secrets set VITE_GOOGLE_MAPS_API_KEY=<server key>

# --- PostHog product analytics (optional) ---
# Leave empty and analytics is completely inert: nothing initialises, no
# network call is made, no event is sent. That is the default for tests, CI
# and any checkout without a key.
#
# This is the *project* API key (starts with `phc_`), which is designed to be
# public and write-only — it can send events, it cannot read your data. Never
# put a personal API key (`phx_`) here: those can read and delete, and this
# value ships in the client bundle.
VITE_POSTHOG_KEY=

# PostHog Cloud is region-specific and sending to the wrong region silently
# drops every event. US is the default; use https://eu.i.posthog.com for EU,
# or your own host if self-hosting.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
