# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Client-safe (public) config — safe to ship to the browser ---
# Unprefixed vars below are read by Phase 1's backend Vitest suite (tests/,
# via Node/dotenv). The VITE_-prefixed pair is what the frontend (src/, this
# phase) reads — Vite only exposes import.meta.env.VITE_* to client bundles,
# so both names are needed for the same two values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-only secrets — NEVER reference from client-side/browser code ---
# Used only by trusted server contexts (e.g. CI test setup, admin scripts,
# Edge Functions that explicitly need to bypass RLS). Phase 1's Postgres
# functions do NOT require this key: SECURITY DEFINER functions bypass RLS at
# the Postgres level, independent of this Supabase API key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (§6). Not configured in Phase 1 — no OAuth client exists yet
# for this project. Fill in and enable the Google provider in Supabase Auth
# settings once credentials are issued.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Dev-only test/fixture accounts (see supabase/README.md "Test accounts") ---
# Created directly in the dev Supabase project for Phase 1 verification. Never
# real credentials — rotate or delete before any production-adjacent use.
TEST_ADMIN_EMAIL=admin.superadmin@dev.madli.test
TEST_USER_EMAIL=user.test@dev.madli.test
TEST_OWNER_EMAIL=owner.test@dev.madli.test
TEST_ACCOUNT_PASSWORD=change-me

# Phase 3: a second admin account (different tier, partial grant — see
# PHASE_4_HANDOFF.md) so admin permission-scoped UI can be tested for real
# against an account that does NOT have every grant.
TEST_ADMIN2_EMAIL=admin.moderation@dev.madli.test

# Phase 3: the app's own deployed origin. Used by the share-preview Edge
# Function (supabase/functions/share-preview) to build canonical/OG URLs —
# set this as the Edge Function's APP_URL secret once a real deploy exists;
# falls back to a placeholder otherwise (see PHASE_4_HANDOFF.md).
# APP_URL=https://your-deployed-frontend.example
